{% extends '@SyliusShop/layout.html.twig' %}

{% block title %}
    {{ 'sylius.ui.payment'|trans }} - {{ 'sylius.ui.checkout'|trans }}
{% endblock %}

{% block content %}
    <div class="ui segment">
        <h1 class="ui header">
            <i class="credit card icon"></i>
            <div class="content">
                {{ 'sylius.ui.payment'|trans }}
                <div class="sub header">{{ 'sylius.ui.checkout'|trans }}</div>
            </div>
        </h1>

        <div class="ui info message">
            <div class="header">
                {{ 'sylius.ui.processing_payment'|trans }}
            </div>
            <p>{{ 'sylius.ui.please_wait'|trans }}</p>
        </div>

        {% if payment_details.iframe_url is defined %}
            <div class="ui segment">
                <h3>{{ 'sylius.ui.payment_form'|trans }}</h3>
                <iframe 
                    src="{{ payment_details.iframe_url }}" 
                    width="100%" 
                    height="600px" 
                    frameborder="0"
                    allowfullscreen>
                </iframe>
            </div>
        {% else %}
            <div class="ui warning message">
                <div class="header">
                    {{ 'sylius.ui.payment_error'|trans }}
                </div>
                <p>{{ 'sylius.ui.payment_not_available'|trans }}</p>
            </div>
        {% endif %}

        <div class="ui divider"></div>

        <div class="ui grid">
            <div class="two column row">
                <div class="left floated column">
                    <a href="{{ path('sylius_shop_homepage') }}" class="ui button">
                        <i class="home icon"></i>
                        {{ 'sylius.ui.back_to_store'|trans }}
                    </a>
                </div>
                <div class="right floated column">
                    <a href="{{ path('sylius_shop_checkout_complete') }}" class="ui primary button">
                        <i class="check icon"></i>
                        {{ 'sylius.ui.complete_order'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
